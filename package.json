{
  "name": "wellthyfy-outreach-crm",
  "private": true,
  "version": "0.1.0",
  "description": "Wellthyfy Outreach CRM — internal training-outreach CRM",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api,worker -c cyan,green,magenta \"npm run dev -w @wellthyfy/web\" \"npm run dev -w @wellthyfy/api\" \"npm run dev -w @wellthyfy/worker\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e -w @wellthyfy/web",
    "db:generate": "npm run db:generate -w @wellthyfy/shared",
    "db:migrate": "npm run db:migrate -w @wellthyfy/shared",
    "db:seed": "npm run db:seed -w @wellthyfy/shared",
    "create-admin": "npm run create-admin -w @wellthyfy/api --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
