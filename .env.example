# =====================================================================
# Wellthyfy Outreach CRM — environment variables
# Copy to .env (git-ignored) and fill in. NEVER commit real values.
# The api and worker read the root .env; the web app reads the VITE_* values.
# =====================================================================

# ---- Supabase (Project Settings → API) -------------------------------
# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Public anon key (safe for the browser; also copied into VITE_SUPABASE_ANON_KEY)
SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY (api + worker). Used for inviting users and Storage uploads.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: legacy HS256 JWT secret (Project Settings → API → JWT secret). If empty, the API verifies
# tokens with the project's JWKS at $SUPABASE_URL/auth/v1/.well-known/jwks.json (asymmetric keys).
SUPABASE_JWT_SECRET=
# Storage bucket for proposals and backups (private bucket; created by `npm run db:seed` if missing)
SUPABASE_STORAGE_BUCKET=wellthyfy-crm

# ---- Database ---------------------------------------------------------
# Supabase Postgres connection string. Use the DIRECT connection or the SESSION pooler (port 5432):
# pg-boss needs session-level features, so do not use the transaction pooler (port 6543).
# For local tests/e2e you can use an in-process database: DATABASE_URL=pglite://memory
DATABASE_URL=postgresql://postgres:password@db.abcd1234.supabase.co:5432/postgres

# ---- Titan Mail (outreach email ONLY) ----------------------------------
# Mailbox credentials. Read only from env; never stored in the DB, never logged, never sent to the browser.
TITAN_USER=ceo@wellthyfy.in
TITAN_PASSWORD=
# Display name used in the From header: "TITAN_FROM_NAME <TITAN_USER>"
TITAN_FROM_NAME=Selvaganapathy V. | Wellthyfy Lifestyle Ventures
# dry_run (default) = SMTP replaced by a logger, IMAP writes skipped and logged. live = really send.
EMAIL_MODE=dry_run

# ---- Resend (internal staff notifications ONLY — never prospects) -------
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. "Wellthyfy CRM <crm-alerts@notify.wellthyfy.in>"
RESEND_FROM=
# Comma-separated staff addresses that receive the daily digest and "interested" reply alerts
ALERT_EMAIL_TO=

# ---- AI (Anthropic) ----------------------------------------------------
ANTHROPIC_API_KEY=
# Default model; Settings can switch to the optional model below
AI_MODEL_DEFAULT=claude-haiku-5-5
AI_MODEL_OPTIONAL=claude-sonnet-5-5
# INR per USD used for cost tracking
USD_TO_INR=88

# ---- Lead search + email verification ----------------------------------
SERPER_API_KEY=
ZEROBOUNCE_API_KEY=

# ---- Monitoring --------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---- URLs --------------------------------------------------------------
# Web app origin (CORS allow-list for the API)
APP_URL=http://localhost:5173
# API base URL (used by the web app via VITE_API_URL)
API_URL=http://localhost:4000
PORT=4000

# ---- Time zone ---------------------------------------------------------
# Data is stored in UTC; scheduling and display use Asia/Kolkata.
TZ=Asia/Kolkata

# ---- Logging -----------------------------------------------------------
LOG_LEVEL=info

# ---- Optional operational settings ---------------------------------------
# Worker HTTP health endpoint port (leave empty on Render background workers)
WORKER_HEALTH_PORT=
# Local folder used for proposal PDFs / backups when Supabase Storage is not configured (development)
LOCAL_STORAGE_DIR=.storage
# pg_dump binary for nightly backups (the worker Docker image sets this); falls back to a JSON export if missing
PG_DUMP_PATH=

# ---- Web app (Vite exposes only VITE_* to the browser) ------------------
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
VITE_API_URL=http://localhost:4000
VITE_SENTRY_DSN=
